# Copy to .env and fill in. Do not commit .env.
# Hindsight speaks to any provider it supports; for your OpenRouter key:
HINDSIGHT_API_LLM_PROVIDER=openrouter
HINDSIGHT_API_LLM_MODEL=openai/gpt-4o-mini
HINDSIGHT_API_LLM_API_KEY=sk-or-your-openrouter-key

# Any cheap OpenRouter model works for extraction, for example:
#   openai/gpt-4o-mini
#   deepseek/deepseek-chat-v3
#   z-ai/glm-4.5-flash
# Pick one from https://openrouter.ai/models and match omp's existing credits.
